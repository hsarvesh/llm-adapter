# Active provider: openai | gemini | anthropic | cohere | mistral | huggingface | ollama | azure | custom
ACTIVE_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# Provider API Keys (configure only the ones you use)
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
COHERE_API_KEY=
MISTRAL_API_KEY=
HF_API_TOKEN=

# Azure OpenAI
AZURE_OPENAI_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434/v1

# Custom Provider
CUSTOM_LLM_URL=
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_HEADERS={}
CUSTOM_LLM_MODEL=

# App Settings
MAX_FILE_SIZE_MB=50
CACHE_TTL_SECONDS=300
CACHE_MAX_SIZE=100
LOG_LEVEL=INFO
